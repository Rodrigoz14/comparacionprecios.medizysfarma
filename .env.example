# Copia este archivo a .env y completa los valores reales.
# Nunca subas .env (con secretos reales) al repositorio.

# Base de datos PostgreSQL
# Ver README.md "Base de datos local" — con `npx prisma dev` el puerto es dinámico,
# copia la URL real que muestre `npx prisma dev ls`. Con Docker, usa el puerto fijo 5432.
DATABASE_URL="postgresql://medizys:devpass@localhost:5432/medizys?schema=public"

# Proveedores de IA (se usan a través de la capa de abstracción en /lib/ai)
CLAUDE_API_KEY=
OPENAI_API_KEY=

# Correo electrónico (fase posterior - integración con proveedores)
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=

# Autenticación — genera uno propio, nunca reutilices el de otro entorno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Almacenamiento de archivos originales de proveedores
STORAGE_URL=
